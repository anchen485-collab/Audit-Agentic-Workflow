APP_ENV=local
AUDIT_STORAGE_DIR=storage

LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_HEALTH_CHECK_ENABLED=true

COMPANY_PROVIDER=mock
AUDIT_LOG_LEVEL=INFO

# 本地开发默认关闭认证；企业环境建议改为 true。
AUTH_ENABLED=false
# 格式：token:user_id:tenant_id:role1|role2;token2:user_id2:tenant_id2:role
AUTH_TOKENS=uploader-token:uploader_001:tenant_a:uploader;reviewer-token:reviewer_001:tenant_a:reviewer;auditor-token:auditor_001:tenant_a:auditor

# 上传 Excel 安全限制，防止异常大文件拖慢或拖垮服务。
AUDIT_MAX_EXCEL_SHEETS=5
AUDIT_MAX_EXCEL_ROWS=5000
AUDIT_MAX_EXCEL_COLUMNS=50

EVIDENCE_CONCURRENCY=5
CLASSIFICATION_CONCURRENCY=3
RULE_CONCURRENCY=8
LIGHTWEIGHT_AGENT_CONCURRENCY=8

# 规则召回配置：默认召回 Top5，最多扩展到 Top8。
RULE_RECALL_DEFAULT_TOP_K=5
RULE_RECALL_MAX_TOP_K=8
RULE_RECALL_EXACT_MATCH_SCORE_THRESHOLD=7
